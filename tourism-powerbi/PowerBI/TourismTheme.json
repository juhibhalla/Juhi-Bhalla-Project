{
  "name": "Tourism Theme",
  "dataColors": [
    "#1F77B4",
    "#F28E2B",
    "#2CA58D",
    "#E15759",
    "#0B3C5D",
    "#9C755F",
    "#B07AA1",
    "#EDC948",
    "#76B7B2",
    "#FF9DA7"
  ],
  "background": "#FFFFFF",
  "foreground": "#1B2A3A",
  "tableAccent": "#1F77B4",
  "good": "#2CA58D",
  "neutral": "#EDC948",
  "bad": "#E15759",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 11,
      "color": "#1B2A3A"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 9,
      "color": "#5B6B7F"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 22,
      "color": "#0B3C5D"
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F3F6FA"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "*": {
      "*": {
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E1E6EF"
              }
            },
            "radius": 8
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "preset": "Center",
            "transparency": 85
          }
        ]
      }
    }
  }
}
